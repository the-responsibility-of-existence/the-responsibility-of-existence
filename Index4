<script>
(function () {
  "use strict";

  var root = document.documentElement;

  var giscusRetries = null;

  function pushGiscusTheme() {
    var iframe = document.querySelector("iframe.giscus-frame");
    if (!iframe || !iframe.contentWindow) return false;
    try {
      iframe.contentWindow.postMessage(
        { giscus: { setConfig: { theme: root.dataset.theme === "dark" ? "dark" : "light" } } },
        "https://giscus.app"
      );
      return true;
    } catch (e) { return false; }
  }

  function updateGiscusTheme() {
    if (giscusRetries) { clearInterval(giscusRetries); giscusRetries = null; }
    if (pushGiscusTheme()) return;
    var attempts = 0;
    giscusRetries = setInterval(function () {
      attempts++;
      if (pushGiscusTheme() || attempts >= 20) {
        clearInterval(giscusRetries);
        giscusRetries = null;
      }
    }, 250);
  }

  window.addEventListener("message", function (e) {
    if (e.origin !== "https://giscus.app") return;
    if (e.data && e.data.giscus) pushGiscusTheme();
  });

  var themeBtn = document.getElementById("themeToggle");
  var themeIcon = document.getElementById("themeIcon");
  var themeLabel = document.getElementById("themeLabel");

  function applyTheme(theme) {
    root.dataset.theme = theme;
    themeIcon.textContent = theme === "dark" ? "☀" : "☾";
    themeLabel.textContent = theme === "dark" ? "Light" : "Dark";
    themeBtn.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
    updateGiscusTheme();
  }

  applyTheme(root.dataset.theme === "dark" ? "dark" : "light");

  themeBtn.addEventListener("click", function () {
    var next = root.dataset.theme === "dark" ? "light" : "dark";
    applyTheme(next);
    try { localStorage.setItem("roe-theme", next); } catch (e) {}
  });

  var printBtn = document.getElementById("printBtn");
  if (printBtn) printBtn.addEventListener("click", function () { window.print(); });

  var toc = document.getElementById("toc");
  var tocToggle = document.getElementById("tocToggle");

  if (tocToggle && toc) {
    tocToggle.addEventListener("click", function () {
      var open = toc.classList.toggle("is-open");
      tocToggle.setAttribute("aria-expanded", open ? "true" : "false");
    });

    toc.addEventListener("click", function (e) {
      if (e.target.tagName === "A" && window.innerWidth <= 900) {
        toc.classList.remove("is-open");
        tocToggle.setAttribute("aria-expanded", "false");
      }
    });
  }

  var links = Array.prototype.slice.call(document.querySelectorAll('.toc a[href^="#"]'));

  var targets = links.map(function (a) {
    return document.querySelector(a.getAttribute("href"));
  }).filter(Boolean);

  targets.sort(function (a, b) {
    return a.compareDocumentPosition(b) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1;
  });

  function updateActiveToc() {
    if (!targets.length) return;
    var threshold = 120;
    var activeId = targets[0].id;
    for (var i = 0; i < targets.length; i++) {
      if (targets[i].getBoundingClientRect().top <= threshold) activeId = targets[i].id;
      else break;
    }
    links.forEach(function (l) {
      var isActive = l.getAttribute("href") === "#" + activeId;
      l.classList.toggle("is-active", isActive);
      if (isActive) l.setAttribute("aria-current", "location");
      else l.removeAttribute("aria-current");
    });
  }

  var bar = document.getElementById("progressBar");
  var toTop = document.getElementById("toTop");
  var ticking = false;

  function onScroll() {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(function () {
      var doc = document.documentElement;
      var max = doc.scrollHeight - doc.clientHeight;
      var ratio = max > 0 ? doc.scrollTop / max : 0;
      bar.style.transform = "scaleX(" + Math.min(1, Math.max(0, ratio)) + ")";
      toTop.classList.toggle("is-visible", doc.scrollTop > 600);
      updateActiveToc();
      ticking = false;
    });
  }

  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
  onScroll();

  toTop.addEventListener("click", function () {
    var behavior = matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth";
    window.scrollTo({ top: 0, behavior: behavior });
  });

  document.querySelectorAll('section[id] > h2, section[id] > h3.section-title, section[id] > h4[id], .coda[id] > h3').forEach(function (h) {
    var hasOwnId = (h.tagName === 'H4' && h.id);
    var container = h.closest('section, .coda');
    var targetId = hasOwnId ? h.id : (container ? container.id : null);
    if (!targetId) return;
    if (h.querySelector('.anchor-link')) return;
    var text = (h.textContent || '').replace(/\s+/g, ' ').trim();
    var a = document.createElement('a');
    a.href = '#' + targetId;
    a.className = 'anchor-link';
    a.setAttribute('aria-label', 'Permalink to ' + (text || targetId));
    a.textContent = '§';
    h.insertBefore(a, h.firstChild);
  });

  var expandBtn = document.getElementById('expandObjections');
  if (expandBtn) {
    expandBtn.addEventListener('click', function () {
      var open = expandBtn.getAttribute('aria-expanded') === 'true';
      document.querySelectorAll('details.objection').forEach(function (d) { d.open = !open; });
      expandBtn.setAttribute('aria-expanded', String(!open));
      expandBtn.textContent = open ? 'Expand all objections' : 'Collapse all objections';
    });
  }

  var readabilityMap = {
    'abstract':'overview','preface':'overview','reader-guide':'overview',
    's1':'deep','s2':'deep','s2-0a':'deep','s3':'deep','s4':'deep','s5':'deep','s5-0a':'deep',
    's6':'deep','s7':'deep','s8':'deep','s9':'deep','s10':'deep','s11':'deep','s12':'deep',
    's12-6':'deep','s12-7':'deep','s13':'deep','s14':'deep','s15':'deep','s15-2b':'deep',
    's16':'deep','s17':'overview',
    'objections':'overview','svensk-sammanfattning':'overview','glossary':'overview',
    'references':'overview','appendix-a':'overview','discussion':'overview','about':'overview'
  };
  document.querySelectorAll('section[id], .coda[id]').forEach(function (sec) {
    var level = readabilityMap[sec.id]; if (!level) return;
    var heading = sec.querySelector('h2, h3.section-title, h3');
    if (!heading) return;
    if (heading.querySelector('.readability')) return;
    var b = document.createElement('span');
    b.className = 'readability';
    b.dataset.level = level;
    b.textContent = level.charAt(0).toUpperCase() + level.slice(1);
    heading.appendChild(b);
  });
})();
</script>
