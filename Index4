<style>
  :root{
    --text:#1a1a1a;--bg:#fdfdfb;--bg-alt:#f5f2ea;--bg-elev:#ffffff;
    --muted:#6b6b6b;--accent:#6b4a2b;--accent-soft:#f5f2ea;
    --rule:#d8d4c8;--rule-strong:#b8b0a0;--link:#6b4a2b;
    --shadow:0 1px 2px rgba(0,0,0,.04);--maxw:68ch;
  }
  [data-theme="dark"]{
    --text:#e8e4dc;--bg:#1a1815;--bg-alt:#22201c;--bg-elev:#2a2722;
    --muted:#a09a8e;--accent:#c9a87c;--accent-soft:#2a2620;
    --rule:#3a3630;--rule-strong:#4a453c;--link:#c9a87c;
    --shadow:0 1px 2px rgba(0,0,0,.3);
  }
  *{box-sizing:border-box}
  html{font-size:18px;scroll-behavior:smooth}
  body{margin:0;background:var(--bg);color:var(--text);
    font-family:"Fraunces","Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif;
    font-optical-sizing:auto;line-height:1.7;-webkit-font-smoothing:antialiased;
    transition:background .3s,color .3s}
  h1,h2,h3,h4{line-height:1.22;margin:0}
  h1{font-size:clamp(1.9rem,4.5vw,2.8rem);font-weight:600;letter-spacing:-.02em}
  a{color:var(--link)}
  img{max-width:100%;height:auto}
  .skip{position:absolute;left:-9999px;top:0;z-index:999;
    background:var(--accent);color:var(--bg);padding:.7rem 1.1rem;
    font-family:ui-sans-serif,system-ui,sans-serif;font-size:.9rem;
    border-radius:0 0 8px 0;text-decoration:none}
  .skip:focus{left:0}
  .wrap{max-width:1180px;margin:0 auto;padding:0 1.6rem}
  .progress{position:fixed;top:0;left:0;right:0;height:2px;
    background:transparent;z-index:100;pointer-events:none}
  .progress__bar{height:100%;background:var(--accent);
    transform:scaleX(0);transform-origin:0 50%;transition:transform .1s linear}

  .hero{padding:4.5rem 0 2.5rem;position:relative;text-align:left}
  .hero h1{margin:0 0 .6rem}
  .subtitle{font-size:1.1rem;color:var(--muted);max-width:56ch;
    margin:0 0 1.6rem;line-height:1.55;font-style:italic}
  .hero-ornament{width:68px;height:1px;
    background:linear-gradient(90deg, transparent, var(--accent), transparent);
    opacity:.55;margin:0 0 1.3rem;position:relative}
  .hero-ornament::after{content:"";position:absolute;left:50%;top:50%;
    transform:translate(-50%,-50%) rotate(45deg);width:5px;height:5px;
    background:var(--accent);opacity:.8}
  .hero .kicker{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.78rem;letter-spacing:.18em;text-transform:uppercase;color:var(--accent);
    margin:0 0 1.1rem;font-weight:600}
  .hero__meta{display:flex;flex-wrap:wrap;gap:.6rem 1.2rem;align-items:center;
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.85rem;color:var(--muted)}
  .hero__meta .sep{opacity:.5}
  .tools{position:absolute;top:1.2rem;right:0;display:flex;gap:.5rem}
  .btn{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.82rem;line-height:1;padding:.55rem .8rem;border-radius:8px;
    border:1px solid var(--rule);background:var(--bg-alt);color:var(--text);
    cursor:pointer;display:inline-flex;align-items:center;gap:.4rem;box-shadow:var(--shadow);
    transition:border-color .15s, color .15s, background .15s}
  .btn:hover{border-color:var(--accent);color:var(--accent)}
  .btn--toc{display:none}

  .layout{display:grid;grid-template-columns:264px minmax(0,1fr);gap:3.5rem;
    align-items:start;padding:3rem 0 5rem}

  .toc{position:sticky;top:1.5rem;max-height:calc(100vh - 3rem);overflow-y:auto;
    padding-right:.5rem;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
  .toc__title{font-size:.72rem;letter-spacing:.18em;text-transform:uppercase;
    color:var(--muted);margin:0 0 .9rem .75rem;font-weight:600}
  .toc ol{list-style:none;margin:0;padding:0}
  .toc ol > li{border-bottom:1px solid var(--rule)}
  .toc ol > li.sub{border-bottom:0}
  .toc ol > li:last-child{border-bottom:0}
  .toc a{display:block;padding:.5rem .75rem;border-left:2px solid transparent;
    color:var(--muted);text-decoration:none;font-size:.86rem;line-height:1.35;
    border-radius:0 6px 6px 0;transition:color .15s,background .15s,border-color .15s}
  .toc a:hover{color:var(--text);background:var(--bg-alt)}
  .toc a.is-active{color:var(--accent);border-left-color:var(--accent);
    background:var(--accent-soft);font-weight:600}
  .toc .sub a{padding:.4rem .75rem .4rem 1.55rem;font-size:.8rem;border-bottom:0}
  .toc .part-label{display:block;padding:.75rem .75rem .3rem;font-size:.7rem;
    letter-spacing:.14em;text-transform:uppercase;color:var(--accent);font-weight:700;
    border-bottom:0}

  article{max-width:var(--maxw)}
  main:focus, article:focus{outline:none}
  section{scroll-margin-top:2rem;margin:0 0 3.2rem}
  section > h2{font-family:"Fraunces","Iowan Old Style",Georgia,serif;
    font-optical-sizing:auto;font-size:clamp(1.5rem,3vw,2rem);line-height:1.18;
    margin:0 0 1.1rem;letter-spacing:-.014em;font-weight:600;padding-top:.4rem;position:relative}
  section > h2 .num{color:var(--accent);font-weight:400;
    margin-right:.55em;font-size:.8em;font-variant-numeric:tabular-nums}
  .coda h2{position:relative}
  h3{font-size:1.12rem;margin:2rem 0 .7rem;font-weight:600;letter-spacing:-.005em;
     scroll-margin-top:1.5rem}
  h4{font-size:1rem;margin:1.4rem 0 .5rem;font-weight:600}
  p{margin:0 0 1.15rem}
  strong{font-weight:600}
  em{font-style:italic}
  ol,ul{margin:0 0 1.15rem;padding-left:1.4rem}
  li{margin:0 0 .4rem}

  .section-lede{font-size:1.02rem;color:var(--muted);font-style:italic;
    margin:-.4rem 0 1.4rem;line-height:1.55;max-width:60ch;
    padding-left:1rem;border-left:2px solid var(--rule)}

  .anchor-link{position:absolute;left:-1.4em;top:.55em;color:var(--muted);
    text-decoration:none;font-size:.82em;font-weight:400;opacity:0;
    transition:opacity .15s, color .15s;line-height:1}
  section > h2:hover .anchor-link,.coda h2:hover .anchor-link,
  .anchor-link:focus{opacity:.55}
  .anchor-link:hover{opacity:1;color:var(--accent)}
  @media (max-width:900px){.anchor-link{display:none}}

  article p a, article li a, article dd a, article h3 a, article h4 a, article td a{
    color:var(--link);text-decoration:none;border-bottom:1px solid var(--rule);
    transition:border-color .2s, color .2s}
  article p a:hover, article li a:hover, article dd a:hover,
  article h3 a:hover, article h4 a:hover, article td a:hover{
    border-bottom-color:var(--accent);color:var(--accent)}

  .abstract{border-top:3px solid var(--accent);border-bottom:1px solid var(--rule);
    padding:1.8rem 0 1.6rem;margin:0 0 1.6rem}
  .abstract__title{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.72rem;letter-spacing:.2em;text-transform:uppercase;
    color:var(--accent);margin:0 0 1rem;font-weight:700}
  .abstract p{font-size:.99rem;line-height:1.72;color:var(--text)}
  .abstract__lede{font-size:1.1rem !important;line-height:1.6 !important;
    margin-bottom:1.5rem !important;padding-bottom:1.3rem;
    border-bottom:1px solid var(--rule)}
  .abstract__lede strong{color:var(--accent)}

  .preface{background:var(--bg-alt);border-left:4px solid var(--accent);
    border-radius:0 10px 10px 0;padding:1.6rem 1.8rem;margin:1.6rem 0 2rem}
  .preface h2{margin:0 0 .5rem;font-size:1.2rem;padding-top:0}
  .preface p{font-size:.97rem;line-height:1.65}
  .preface ol{padding-left:1.3rem;font-size:.96rem;margin:0 0 .8rem}
  .preface ol li{margin:0 0 .5rem;line-height:1.6}
  .preface .preface-note{font-size:.86rem;color:var(--muted);font-style:italic;
    margin:1rem 0 0;padding-top:.8rem;border-top:1px solid var(--rule)}

  .roadmap-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));
    gap:.9rem;margin:1.4rem 0 0}
  .roadmap-card{background:var(--bg-elev);border:1px solid var(--rule);
    border-radius:8px;padding:.9rem 1rem;display:flex;flex-direction:column}
  .roadmap-card__label{font-family:ui-sans-serif,system-ui,sans-serif;
    font-size:.68rem;letter-spacing:.14em;text-transform:uppercase;
    color:var(--accent);font-weight:700;margin:0 0 .25rem}
  .roadmap-card__title{font-weight:600;font-size:.95rem;margin:0 0 .4rem;line-height:1.25}
  .roadmap-card__desc{font-size:.85rem;line-height:1.5;color:var(--muted);
    margin:0 0 .6rem;flex:1}
  .roadmap-card__sections{font-family:ui-sans-serif,system-ui,sans-serif;
    font-size:.76rem;color:var(--accent);font-weight:600;margin:0}

  .reader-guide{background:var(--accent-soft);border-left:4px solid var(--accent);
    border-radius:0 10px 10px 0;padding:1.5rem 1.75rem;margin:2rem 0 2.5rem}
  .reader-guide h2{margin:0 0 .4rem;font-size:1.2rem;border-top:none;padding-top:0}
  .reader-guide h3{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);
    margin:1.2rem 0 .4rem;font-weight:700}
  .reader-guide ul{margin:0 0 .6rem;padding-left:1.3rem;font-size:.93rem}
  .reader-guide ol{margin:0 0 .6rem;padding-left:1.3rem;font-size:.93rem}
  .reader-guide ol li{margin:0 0 .5rem;line-height:1.55}
  .reader-guide .roadmap-grid{margin:.8rem 0 1.4rem}
  .reader-guide li{margin:0 0 .3rem;line-height:1.55}
  .reader-guide p{font-size:.94rem;margin:0 0 .6rem}

  .objection{margin:1.3rem 0;padding:1rem 1.2rem;background:var(--bg-alt);
    border-left:3px solid var(--rule-strong);border-radius:0 8px 8px 0}
  .objection h3{margin:0 0 .5rem;font-size:1rem;color:var(--text);font-weight:600;
    font-style:italic}
  .objection h3 .obj-num{color:var(--accent);margin-right:.45em;
    font-variant-numeric:tabular-nums;font-style:normal;font-weight:700}
  .objection p{margin:0;font-size:.93rem;line-height:1.6}
  .objection p + p{margin-top:.5rem}
  .objection .reply::before{content:"Reply. ";color:var(--accent);font-weight:700;
    font-size:.82em;letter-spacing:.06em;text-transform:uppercase}

  #svensk-sammanfattning{background:var(--accent-soft);border-left:4px solid var(--accent);
    border-radius:0 10px 10px 0;padding:1.6rem 1.8rem;margin:2.5rem 0}
  #svensk-sammanfattning h2{margin:0 0 .5rem;font-size:1.3rem;border-top:none;padding-top:0}
  #svensk-sammanfattning .sv-note{font-size:.84rem;color:var(--muted);font-style:italic;
    margin:0 0 1.2rem;line-height:1.5}
  #svensk-sammanfattning h3{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.76rem;letter-spacing:.14em;text-transform:uppercase;color:var(--accent);
    margin:1.4rem 0 .5rem;font-weight:700}
  #svensk-sammanfattning p,#svensk-sammanfattning li{font-size:.95rem;line-height:1.6}
  #svensk-sammanfattning ol,#svensk-sammanfattning ul{padding-left:1.3rem;margin:0 0 1rem}
  #svensk-sammanfattning li{margin:0 0 .4rem}
  #svensk-sammanfattning .sv-closer{margin-top:1.2rem;padding-top:1rem;
    border-top:1px solid var(--rule);font-size:.95rem;font-style:italic}

  .key-prop{border-left:3px solid var(--accent);padding:1.2rem 1.4rem;margin:2rem 0;
    background:var(--accent-soft);border-radius:0 10px 10px 0}
  .key-prop::before{content:"Key proposition";display:block;
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.68rem;letter-spacing:.18em;text-transform:uppercase;
    color:var(--accent);font-weight:700;margin:0 0 .6rem}
  .key-prop[data-label]::before{content:attr(data-label)}
  .key-prop p{font-family:"Fraunces","Iowan Old Style",Georgia,serif;
    font-optical-sizing:auto;font-style:italic;
    font-size:1.02rem;line-height:1.55;margin:0 0 .6rem}
  .key-prop p:last-child{margin-bottom:0}
  .key-prop p strong{font-style:normal}
  .key-points{margin:2rem 0 0;padding:.95rem 1.2rem;border-left:3px solid var(--accent);
    background:var(--bg-alt);border-radius:0 8px 8px 0}
  .key-points::before{content:"Key points";display:block;
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;
    color:var(--accent);font-weight:700;margin:0 0 .6rem}
  .key-points ul{margin:0;padding-left:1.3rem;font-size:.92rem}
  .key-points li{margin:0 0 .35rem;line-height:1.55}
  .key-points li:last-child{margin-bottom:0}

  blockquote{margin:2rem 0;padding:.6rem 0 .6rem 1.4rem;
    border-left:2px solid var(--accent);color:var(--text);
    font-family:"Fraunces","Iowan Old Style",Georgia,serif;
    font-optical-sizing:auto;font-style:italic;font-size:1.13rem;line-height:1.6}
  blockquote p{margin:0}
  blockquote p:last-child{margin-bottom:0}

  .note{border:0;border-left:2px solid var(--accent);background:var(--bg-alt);
    border-radius:0 8px 8px 0;padding:.9rem 1.1rem;font-size:.94rem;
    color:var(--muted);margin:1.4rem 0}
  .note strong{color:var(--text)}

  .table-wrap{overflow-x:auto;margin:1.4rem 0;border-radius:8px;border:1px solid var(--rule)}
  table{width:100%;border-collapse:collapse;font-size:.93rem;background:var(--bg-elev)}
  thead{background:var(--bg-alt)}
  th,td{padding:.65rem 1rem;text-align:left;border-bottom:1px solid var(--rule);vertical-align:top}
  thead th{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.74rem;letter-spacing:.08em;text-transform:uppercase;
    color:var(--accent);font-weight:700}
  tbody tr:last-child td{border-bottom:0}
  .table-wrap caption{text-align:left;font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.78rem;letter-spacing:.08em;text-transform:uppercase;color:var(--accent);
    font-weight:700;padding:.7rem 1rem;background:var(--bg-alt);border-bottom:1px solid var(--rule)}

  hr.sep{border:0;height:auto;margin:3.4rem 0;text-align:center;
    background:transparent;line-height:1;font-size:1.1rem}
  hr.sep::before{content:"· · ·";display:inline-block;color:var(--accent);opacity:.55;
    letter-spacing:.35em;font-family:"Fraunces","Iowan Old Style",Georgia,serif;font-size:1.35rem}

  .part-divider{margin:3.5rem 0 2rem;padding:1.2rem 0 .8rem;
    border-top:1px solid var(--rule-strong);border-bottom:1px solid var(--rule);
    text-align:center}
  .part-divider__label{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;
    color:var(--accent);font-weight:700;margin:0 0 .4rem}
  .part-divider__title{font-family:"Fraunces","Iowan Old Style",Georgia,serif;
    font-optical-sizing:auto;font-size:clamp(1.2rem,2.4vw,1.55rem);
    font-weight:600;letter-spacing:-.01em;margin:0;color:var(--text)}

  .coda{margin:3.5rem 0 2rem;padding:2rem 1.5rem;border-top:2px solid var(--accent);
    border-bottom:1px solid var(--rule);background:var(--accent-soft)}
  .coda__label{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.72rem;letter-spacing:.22em;text-transform:uppercase;
    color:var(--accent);font-weight:700;margin:0 0 .6rem}
  .coda h2{font-family:"Fraunces","Iowan Old Style",Georgia,serif;
    font-optical-sizing:auto;font-size:clamp(1.5rem,3vw,2rem);line-height:1.18;
    margin:0 0 1.1rem;letter-spacing:-.014em;font-weight:600}
  .coda p{font-size:1.02rem;line-height:1.7}
  .coda p:last-child{margin-bottom:0}

  .glossary{margin:1.2rem 0}
  .glossary dt{font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-weight:700;font-size:.9rem;color:var(--accent);margin:1rem 0 .2rem}
  .glossary dt:first-child{margin-top:0}
  .glossary dd{margin:0 0 .6rem;font-size:.93rem;line-height:1.55}

  .references{font-size:.92rem;line-height:1.6;color:var(--muted)}
  .references ol{padding-left:1.4rem}
  .references li{margin:0 0 .55rem}
  .references em{color:var(--text)}

  .contact-grid{display:grid;gap:1rem;
    grid-template-columns:repeat(auto-fit,minmax(240px,1fr));margin:1.6rem 0}
  .contact-card{display:block;padding:1.1rem 1.3rem;border:1px solid var(--rule);
    border-radius:10px;background:var(--bg-alt);text-decoration:none;color:inherit;
    transition:border-color .2s}
  .contact-card:hover{border-color:var(--accent)}
  .contact-card h3{margin:0 0 .35rem;font-size:1rem;color:var(--accent);
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif}
  .contact-card p{margin:0;font-size:.92rem;color:var(--muted);line-height:1.55}
  .giscus-wrap{margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--rule)}
  .giscus-wrap noscript p{color:var(--muted);font-size:.95rem}

  footer{border-top:1px solid var(--rule);padding:2.5rem 0 4rem;
    font-family:ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;
    font-size:.85rem;color:var(--muted)}
  footer p{margin:0 0 .5rem}

  .totop{position:fixed;right:1.4rem;bottom:1.4rem;z-index:90;
    width:40px;height:40px;border-radius:50%;display:grid;place-items:center;
    background:var(--accent);color:var(--bg);border:0;cursor:pointer;font-size:1rem;
    opacity:0;pointer-events:none;transform:translateY(10px);
    transition:opacity .25s, transform .25s}
  .totop.is-visible{opacity:1;pointer-events:auto;transform:translateY(0)}

  #about p{color:var(--muted);font-style:italic}
  #about .note{font-style:normal}
  #about .note strong{font-style:normal}
  #about h3{font-style:normal;color:var(--text)}

  @media (max-width:900px){
    .layout{grid-template-columns:1fr;gap:1.5rem;padding-top:1.5rem}
    .toc{position:static;max-height:none;display:none;border:1px solid var(--rule);
      border-radius:10px;padding:1rem;background:var(--bg-alt)}
    .toc.is-open{display:block}
    .btn--toc{display:inline-flex}
    .abstract{padding:1.3rem 0 1.1rem}
    .key-prop{padding:1rem 1.1rem}
    .coda{padding:1.5rem 1.1rem}
    .reader-guide{padding:1.2rem 1.2rem}
    .roadmap-grid{grid-template-columns:1fr 1fr}
